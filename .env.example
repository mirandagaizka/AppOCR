# Copia como .env para desarrollo local

# API key de Anthropic → console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# PIN de acceso a la app (déjalo vacío para acceso sin contraseña)
ACCESS_KEY=tu_pin_aqui

# Conexión a base de datos
# - Vacío → SQLite local en data/facturas.db (no necesitas instalar nada)
# - PostgreSQL → usa una conexión de Neon.tech (gratis) o tu Render DB
DATABASE_URL=

# Directorio local para SQLite y PDFs temporales
DATA_DIR=data
